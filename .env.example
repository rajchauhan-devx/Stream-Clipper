# Google GenAI API Key (Required for Gemini Vision Director, TTS, & Image Overlays)
GEMINI_API_KEY=

# Centralized Model IDs
DIRECTOR_MODEL=gemini-3.8-flash
TTS_MODEL=gemini-3.8-flash-tts
IMAGE_MODEL=gemini-3.1-flash-image

# YouTube Publishing Credentials (Optional - Phase 5)
YOUTUBE_CLIENT_SECRETS_FILE=client_secret.json

# Meta Graph API Credentials for Facebook & Instagram Reels (Optional - Phase 5)
META_ACCESS_TOKEN=
META_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=
PUBLIC_TUNNEL_URL=
